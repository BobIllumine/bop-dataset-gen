# Copy to deploy/.env. Unset values fall back to the `local` profile's services.

# External PostgreSQL (the database must exist; tables are created on start).
#BOP_DATABASE_URL=postgres://bop:password@db.example.lan:5432/bop

# External MinIO or S3. The bucket must exist; an optional prefix follows it.
#BOP_STORAGE_URL=s3://bop-datasets/production
#AWS_ENDPOINT_URL=http://minio.example.lan:9000
#AWS_ALLOW_HTTP=true
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
# Storage requests a job upload, download, or export keeps in flight. Lower it
# for a small MinIO.
#BOP_STORAGE_CONCURRENCY=32

# Several servers on one database: give each a unique, stable name.
#BOP_RUNNER_ID=gpu-host-1
# Days before local copies of failed/cancelled jobs are deleted; 0 keeps them.
#BOP_LOCAL_RETENTION_DAYS=14

# No database or object store at all: SQLite and a directory in the bop-data volume.
#BOP_DATABASE_URL=sqlite:///var/lib/bop/bop.db?mode=rwc
#BOP_STORAGE_URL=file:///var/lib/bop/storage

# A shared token for scripts: `Authorization: Bearer <token>` on /api.
#BOP_API_TOKEN=


# --- Authentication -----------------------------------------------------------
# The server refuses to start on a non-loopback address without one of these,
# unless BOP_ALLOW_ANONYMOUS=true.

# Sign-in through an OIDC provider you already run, such as authentik. In
# authentik: create an OAuth2/OpenID provider (client type public, signing key
# set, redirect URI <studio>/auth/callback, scopes openid profile email
# offline_access) and an application for it; the issuer is the provider's
# "OpenID Configuration Issuer".
#BOP_OIDC_ISSUER=https://auth.example.com/application/o/bop/
#BOP_OIDC_CLIENT_ID=bop-studio
# Only members of these groups (comma-separated) may use the API.
#BOP_OIDC_GROUPS=bop-users
# When the issuer's public address is unreachable from the container:
#BOP_OIDC_JWKS_URL=http://authentik.internal:9000/application/o/bop/jwks/

# authentik in containers instead (-f deploy/authentik.yaml). Generate secrets
# with `openssl rand -base64 60`.
#AUTHENTIK_SECRET_KEY=
#AUTHENTIK_PG_PASS=
#AUTHENTIK_BOOTSTRAP_PASSWORD=
#AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
# The addresses browsers use for authentik and the studio.
#AUTHENTIK_URL=http://localhost:9000
#BOP_STUDIO_URL=http://localhost:3000

# Published ports listen on 127.0.0.1. Set to 0.0.0.0 only behind a firewall
# or when a TLS proxy on this host is not an option.
#BOP_BIND=127.0.0.1
#BOP_STUDIO_BIND=127.0.0.1
#AUTHENTIK_BIND=127.0.0.1
# Host ports, if the defaults are taken. The studio reaches the server over
# the compose network, so changing BOP_PORT needs nothing else.
#BOP_PORT=8080
#BOP_STUDIO_PORT=3000
