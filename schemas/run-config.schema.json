{
  "$defs": {
    "AmbientWire": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "items": {
            "$ref": "#/$defs/NonNegativeF32Schema"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "intensity": {
          "$ref": "#/$defs/NonNegativeF32Schema"
        }
      },
      "required": [
        "color",
        "intensity"
      ],
      "type": "object"
    },
    "AppearanceWire": {
      "additionalProperties": false,
      "properties": {
        "ambient": {
          "$ref": "#/$defs/AmbientWire"
        },
        "background_srgb": {
          "items": {
            "$ref": "#/$defs/UnitF32Schema"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "directional_lights": {
          "items": {
            "$ref": "#/$defs/DirectionalLightWire"
          },
          "type": "array"
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentWire"
            }
          ],
          "description": "An HDR environment map (`.hdr` or `.exr`, equirectangular) lighting the\nscene instead of `ambient`."
        },
        "material_defaults": {
          "$ref": "#/$defs/PbrMaterialWire"
        },
        "point_lights": {
          "items": {
            "$ref": "#/$defs/PointLightWire"
          },
          "type": "array"
        }
      },
      "required": [
        "background_srgb",
        "ambient",
        "directional_lights",
        "point_lights",
        "material_defaults"
      ],
      "type": "object"
    },
    "AssetDistributionSchema": {
      "description": "Schema-only specialization for the runtime-supported asset mixture forms.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/NonBlankStringSchema"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "choice",
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/AssetWeightedValueSchema"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "AssetWeightedValueSchema": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/NonBlankStringSchema"
        },
        "weight": {
          "$ref": "#/$defs/NonNegativeF64Schema"
        }
      },
      "required": [
        "value",
        "weight"
      ],
      "type": "object"
    },
    "AssetWire": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/NonBlankStringSchema"
        },
        "mixture_weight": {
          "$ref": "#/$defs/NonNegativeF64Schema"
        },
        "model_transform": {
          "$ref": "#/$defs/TransformWire"
        },
        "physical_properties": {
          "$ref": "#/$defs/PhysicalPropertyDistributionsWire"
        },
        "source_path": {
          "$ref": "#/$defs/NonBlankStringSchema"
        },
        "source_unit_scale_m": {
          "$ref": "#/$defs/PositiveF32Schema"
        },
        "vhacd": {
          "$ref": "#/$defs/VhacdWire"
        },
        "visual_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/PbrMaterialWire"
            }
          ]
        }
      },
      "required": [
        "id",
        "source_path",
        "source_unit_scale_m",
        "model_transform",
        "mixture_weight",
        "physical_properties",
        "vhacd"
      ],
      "type": "object"
    },
    "BinEntryWire": {
      "additionalProperties": false,
      "description": "One of several bins: the `[bin]` fields plus an identifier and a population.",
      "properties": {
        "floor_thickness_m": {
          "$ref": "#/$defs/PositiveF32Schema"
        },
        "id": {
          "$ref": "#/$defs/NonBlankStringSchema",
          "description": "Unique, nonblank; recorded on every object dropped into this bin."
        },
        "inner_dimensions_m": {
          "items": {
            "$ref": "#/$defs/PositiveF32Schema"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "material_label": {
          "$ref": "#/$defs/NonBlankStringSchema"
        },
        "physical_properties": {
          "$ref": "#/$defs/SurfacePhysicalPropertiesWire"
        },
        "population": {
          "$ref": "#/$defs/PopulationWire"
        },
        "render_material": {
          "anyOf": [
            {
              "$ref": "#/$defs/BinRenderMaterialWire"
            }
          ]
        },
        "wall_thickness_m": {
          "$ref": "#/$defs/PositiveF32Schema"
        },
        "world_from_bin": {
          "$ref": "#/$defs/TransformWire"
        }
      },
      "required": [
        "id",
        "inner_dimensions_m",
        "floor_thickness_m",
        "wall_thickness_m",
        "world_from_bin",
        "material_label",
        "physical_properties",
        "population"
      ],
      "type": "object"
    },
    "BinRenderMaterialWire": {
      "additionalProperties": false,
      "properties": {
        "base_color_srgb": {
          "items": {
            "$ref": "#/$defs/UnitF32Schema"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "metallic": {
          "$ref": "#/$defs/UnitF32Schema"
        },
        "roughness": {
          "$ref": "#/$defs/UnitF32Schema"
        }
      },
      "required": [
        "base_color_srgb",
        "metallic",
        "roughness"
      ],
      "type": "object"
    },
    "BinWire": {
      "additionalProperties": false,
      "properties": {
        "floor_thickness_m": {
          "$ref": "#/$defs/PositiveF32Schema"
        },
        "inner_dimensions_m": {
          "items": {
            "$ref": "#/$defs/PositiveF32Schema"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "material_label": {
          "$ref": "#/$defs/NonBlankStringSchema"
        },
        "physical_properties": {
          "$ref": "#/$defs/SurfacePhysicalPropertiesWire"
        },
        "render_material": {
          "anyOf": [
            {
              "$ref": "#/$defs/BinRenderMaterialWire"
            }
          ]
        },
        "wall_thickness_m": {
          "$ref": "#/$defs/PositiveF32Schema"
        },
        "world_from_bin": {
          "$ref": "#/$defs/TransformWire"
        }
      },
      "required": [
        "inner_dimensions_m",
        "floor_thickness_m",
        "wall_thickness_m",
        "world_from_bin",
        "material_label",
        "physical_properties"
      ],
      "type": "object"
    },
    "BlenderProcDenoiserWire": {
      "enum": [
        "none",
        "oidn",
        "optix"
      ],
      "type": "string"
    },
    "BlenderProcRendererWire": {
      "additionalProperties": false,
      "properties": {
        "denoiser": {
          "$ref": "#/$defs/BlenderProcDenoiserWire",
          "description": "RGB denoiser. Default `oidn`."
        },
        "device_selection": {
          "$ref": "#/$defs/NonBlankStringSchema"
        },
        "executable_path": {
          "$ref": "#/$defs/NonBlankStringSchema"
        },
        "glossy_bounces": {
          "default": 1,
          "description": "Light bounces off glossy surfaces; 0 makes metals reflect only direct\nlight. Default 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "handshake_timeout_s": {
          "$ref": "#/$defs/PositiveF32Schema"
        },
        "noise_threshold": {
          "default": 0.009999999776482582,
          "description": "Adaptive-sampling noise threshold; 0 disables adaptive sampling. Default 0.01.",
          "format": "float",
          "minimum": 0.0,
          "type": "number"
        },
        "request_timeout_s": {
          "$ref": "#/$defs/PositiveF32Schema"
        },
        "samples": {
          "$ref": "#/$defs/PositiveU32Schema",
          "default": 128,
          "description": "Maximum Cycles samples per pixel. Default 128."
        },
        "stderr_tail_capacity": {
          "$ref": "#/$defs/PositiveU32Schema"
        },
        "worker_path": {
          "$ref": "#/$defs/NonBlankStringSchema"
        }
      },
      "required": [
        "executable_path",
        "worker_path",
        "device_selection",
        "handshake_timeout_s",
        "request_timeout_s",
        "stderr_tail_capacity"
      ],
      "type": "object"
    },
    "CameraPoseSchema": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "fixed_world_from_camera": {
              "$ref": "#/$defs/TransformWire"
            }
          },
          "required": [
            "fixed_world_from_camera"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "shell": {
              "$ref": "#/$defs/ShellCameraPoseWire"
            }
          },
          "required": [
            "shell"
          ],
          "type": "object"
        }
      ]
    },
    "CameraProjectionSchema": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "opencv_k": {
              "items": {
                "format": "float",
                "type": "number"
              },
              "maxItems": 9,
              "minItems": 9,
              "type": "array"
            }
          },
          "required": [
            "opencv_k"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "vertical_fov_deg": {
              "$ref": "#/$defs/VerticalFovSchema"
            }
          },
          "required": [
            "vertical_fov_deg"
          ],
          "type": "object"
        }
      ]
    },
    "CameraWire": {
      "additionalProperties": false,
      "properties": {
        "far_m": {
          "$ref": "#/$defs/PositiveF32Schema",
          "description": "Must be greater than `near_m`."
        },
        "id": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "image_size": {
          "$ref": "#/$defs/ImageSizeWire"
        },
        "near_m": {
          "$ref": "#/$defs/PositiveF32Schema"
        },
        "pose": {
          "$ref": "#/$defs/CameraPoseSchema"
        },
        "projection": {
          "$ref": "#/$defs/CameraProjectionSchema"
        }
      },
      "required": [
        "id",
        "image_size",
        "near_m",
        "far_m",
        "projection",
        "pose"
      ],
      "type": "object"
    },
    "DirectionalLightWire": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "items": {
            "$ref": "#/$defs/NonNegativeF32Schema"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "direction_world": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "illuminance_lux": {
          "$ref": "#/$defs/NonNegativeF32Schema"
        }
      },
      "required": [
        "direction_world",
        "color",
        "illuminance_lux"
      ],
      "type": "object"
    },
    "DistributionSchema": {
      "description": "Schema-only specialization of the actual generic distribution wire shape.\n\nUniform bounds must be ordered. Choice values must be nonempty and have a\nfinite, nonnegative weight set with positive total weight; those aggregate\nconstraints remain enforced by `RunConfig` validation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/PositiveF32Schema"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uniform",
              "type": "string"
            },
            "max": {
              "$ref": "#/$defs/PositiveF32Schema"
            },
            "min": {
              "$ref": "#/$defs/PositiveF32Schema"
            }
          },
          "required": [
            "kind",
            "min",
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "choice",
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/WeightedValueSchema"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "DistributionSchema2": {
      "description": "Schema-only specialization of the actual generic distribution wire shape.\n\nUniform bounds must be ordered. Choice values must be nonempty and have a\nfinite, nonnegative weight set with positive total weight; those aggregate\nconstraints remain enforced by `RunConfig` validation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/NonNegativeF32Schema"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uniform",
              "type": "string"
            },
            "max": {
              "$ref": "#/$defs/NonNegativeF32Schema"
            },
            "min": {
              "$ref": "#/$defs/NonNegativeF32Schema"
            }
          },
          "required": [
            "kind",
            "min",
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "choice",
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/WeightedValueSchema2"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "DistributionSchema3": {
      "description": "Schema-only specialization of the actual generic distribution wire shape.\n\nUniform bounds must be ordered. Choice values must be nonempty and have a\nfinite, nonnegative weight set with positive total weight; those aggregate\nconstraints remain enforced by `RunConfig` validation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/UnitF32Schema"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uniform",
              "type": "string"
            },
            "max": {
              "$ref": "#/$defs/UnitF32Schema"
            },
            "min": {
              "$ref": "#/$defs/UnitF32Schema"
            }
          },
          "required": [
            "kind",
            "min",
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "choice",
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/WeightedValueSchema3"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "DistributionSchema4": {
      "description": "Schema-only specialization of the actual generic distribution wire shape.\n\nUniform bounds must be ordered. Choice values must be nonempty and have a\nfinite, nonnegative weight set with positive total weight; those aggregate\nconstraints remain enforced by `RunConfig` validation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/PositiveU32Schema"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uniform",
              "type": "string"
            },
            "max": {
              "$ref": "#/$defs/PositiveU32Schema"
            },
            "min": {
              "$ref": "#/$defs/PositiveU32Schema"
            }
          },
          "required": [
            "kind",
            "min",
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "choice",
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/WeightedValueSchema4"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "EnvironmentWire": {
      "additionalProperties": false,
      "properties": {
        "intensity": {
          "default": 1.0,
          "description": "Radiance scale. Default 1.",
          "format": "float",
          "minimum": 0.0,
          "type": "number"
        },
        "path": {
          "$ref": "#/$defs/NonBlankStringSchema",
          "description": "Image path, relative to the configuration file."
        },
        "rotation_deg": {
          "default": 0.0,
          "description": "Rotation about world +Z in degrees. Default 0.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "ImageSizeWire": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PositiveU32Schema"
        },
        "width": {
          "$ref": "#/$defs/PositiveU32Schema"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "NonBlankStringSchema": {
      "pattern": "\\S",
      "type": "string"
    },
    "NonNegativeF32Schema": {
      "format": "float",
      "minimum": 0.0,
      "type": "number"
    },
    "NonNegativeF64Schema": {
      "format": "double",
      "minimum": 0.0,
      "type": "number"
    },
    "OutputWire": {
      "additionalProperties": false,
      "description": "At least one output channel must be enabled. Visible-instance output also\nrequires the resolved population maximum to fit in the instance-ID domain.",
      "properties": {
        "depth": {
          "type": "boolean"
        },
        "png_compression": {
          "$ref": "#/$defs/PngCompressionWire",
          "description": "PNG compression for RGB and instance frames: `fast` (default),\n`balanced` or `high`. Pixels are identical at every level."
        },
        "rgb": {
          "type": "boolean"
        },
        "visible_instances": {
          "type": "boolean"
        }
      },
      "required": [
        "rgb",
        "depth",
        "visible_instances"
      ],
      "type": "object"
    },
    "PbrMaterialWire": {
      "additionalProperties": false,
      "properties": {
        "base_color_srgb": {
          "items": {
            "$ref": "#/$defs/UnitF32Schema"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "metallic": {
          "$ref": "#/$defs/DistributionSchema3"
        },
        "roughness": {
          "$ref": "#/$defs/DistributionSchema3"
        }
      },
      "required": [
        "base_color_srgb",
        "metallic",
        "roughness"
      ],
      "type": "object"
    },
    "PhysicalPropertyDistributionsWire": {
      "additionalProperties": false,
      "properties": {
        "friction": {
          "$ref": "#/$defs/DistributionSchema2"
        },
        "mass_kg": {
          "$ref": "#/$defs/DistributionSchema"
        },
        "restitution": {
          "$ref": "#/$defs/DistributionSchema3"
        }
      },
      "required": [
        "mass_kg",
        "friction",
        "restitution"
      ],
      "type": "object"
    },
    "PhysicsWire": {
      "additionalProperties": false,
      "properties": {
        "angular_sleep_threshold_rad_s": {
          "default": 0.05000000074505806,
          "format": "float",
          "minimum": 0.0,
          "type": "number"
        },
        "escape_margin_m": {
          "default": 0.0020000000949949026,
          "format": "float",
          "minimum": 0.0,
          "type": "number"
        },
        "fixed_timestep_s": {
          "default": 0.004166666883975267,
          "exclusiveMinimum": 0.0,
          "format": "float",
          "type": "number"
        },
        "linear_sleep_threshold_mps": {
          "default": 0.009999999776482582,
          "format": "float",
          "minimum": 0.0,
          "type": "number"
        },
        "max_steps": {
          "default": 4800,
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "maximum_penetration_m": {
          "default": 0.0020000000949949026,
          "format": "float",
          "minimum": 0.0,
          "type": "number"
        },
        "min_steps": {
          "default": 120,
          "description": "Must not exceed `max_steps`.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "required_stable_checks": {
          "default": 10,
          "description": "The stability interval times this count must not exceed `max_steps`.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "solver_iterations": {
          "$ref": "#/$defs/PositiveU32Schema"
        },
        "stability_check_interval": {
          "default": 24,
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "substeps": {
          "$ref": "#/$defs/PositiveU32Schema"
        }
      },
      "required": [
        "substeps",
        "solver_iterations"
      ],
      "type": "object"
    },
    "PngCompressionWire": {
      "enum": [
        "fast",
        "balanced",
        "high"
      ],
      "type": "string"
    },
    "PointLightWire": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "items": {
            "$ref": "#/$defs/NonNegativeF32Schema"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "luminous_power_lm": {
          "$ref": "#/$defs/NonNegativeF32Schema"
        },
        "position_world_m": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "position_world_m",
        "color",
        "luminous_power_lm"
      ],
      "type": "object"
    },
